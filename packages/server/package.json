{
  "name": "@plico/server",
  "version": "0.0.0",
  "description": "Plico native HTTP API over the runtime and event store",
  "homepage": "https://plico.sohab.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITZSHOAIB/plico.git",
    "directory": "packages/server"
  },
  "keywords": [
    "plico",
    "agent",
    "http",
    "api"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@plico/contracts": "workspace:*",
    "@plico/core": "workspace:*",
    "@plico/runtime": "workspace:*",
    "diff": "8.0.4"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
