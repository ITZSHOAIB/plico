{
  "name": "@plico-ai/cli",
  "version": "0.1.3",
  "description": "The plico command line: validate, run, eval, readiness and serve with Studio",
  "license": "Apache-2.0",
  "homepage": "https://plico.sohab.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITZSHOAIB/plico.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "plico",
    "agent",
    "cli",
    "studio"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "plico": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "NOTICE",
    "dist"
  ],
  "dependencies": {
    "@plico-ai/core": "workspace:*",
    "@plico-ai/server": "workspace:*",
    "@plico-ai/runtime": "workspace:*"
  },
  "devDependencies": {
    "@plico-ai/studio": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/bundle-studio.mjs",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
