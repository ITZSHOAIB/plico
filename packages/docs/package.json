{
  "name": "@plico-ai/docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "deploy:pages": "pnpm --filter @plico-ai/docs build && pnpm dlx wrangler@latest pages deploy out --project-name plico",
    "deploy:pages:preview": "pnpm --filter @plico-ai/docs build && pnpm dlx wrangler@latest pages deploy out --project-name plico --branch preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "fumadocs-core": "16.18.2",
    "fumadocs-mdx": "15.5.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.18.2",
    "lucide-react": "^1.67.0",
    "media-chrome": "^4.19.5",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
