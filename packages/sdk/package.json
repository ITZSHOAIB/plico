{
  "name": "@plico-ai/sdk",
  "version": "0.1.1",
  "description": "Typed helpers for writing Plico projects: defineConfig and defineTool",
  "license": "Apache-2.0",
  "homepage": "https://plico.sohab.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITZSHOAIB/plico.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "plico",
    "agent",
    "typescript",
    "authoring"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "NOTICE",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@plico-ai/contracts": "workspace:*"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
