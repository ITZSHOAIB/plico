{
  "name": "@plico-ai/core",
  "version": "0.1.1",
  "description": "Plico project model: load and validate agent projects from files",
  "license": "Apache-2.0",
  "homepage": "https://plico.sohab.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITZSHOAIB/plico.git",
    "directory": "packages/core"
  },
  "keywords": [
    "plico",
    "agent",
    "validation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "NOTICE",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@plico-ai/contracts": "workspace:*",
    "@plico-ai/sdk": "workspace:*",
    "acorn": "^8.19.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "~0.28.2",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
