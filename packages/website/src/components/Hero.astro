---
import EditorPanel from "./EditorPanel.astro";
---

<section class="hero">
  <div class="hero-left">
    <div class="hero-badges"><div class="eyebrow amber">Building in the open</div><span class="pill">pre-release</span></div>
    <h1>Your agent is a <span>folder of files.</span></h1>
    <p>
      Plico is a file-first framework for agent development — still in its
      early stages, built in public. Define identity in <code>agent.md</code>,
      compose skills in Markdown, extend with TypeScript tools.
      No SDK. No lock-in. Just files.
    </p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="https://github.com/ITZSHOAIB/plico">★ Star on GitHub</a>
      <a class="btn btn-secondary" href="#how-it-works">Explore the vision</a>
    </div>
  </div>
  <EditorPanel />
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1fr);
    gap: 60px;
    align-items: center;
    min-height: calc(100vh - 80px);
    padding: 40px 0 80px;
  }

  .hero-badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 20px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    padding: 3px 9px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--muted-2);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .hero-left h1 {
    font-size: 5rem;
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1;
    overflow-wrap: break-word;
  }

  .hero-left h1 span {
    background: linear-gradient(135deg, var(--green), var(--cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-left p {
    margin-top: 22px;
    color: var(--text-2);
    font-size: 1.125rem;
    line-height: 1.7;
    max-width: 560px;
  }

  @media (max-width: 1120px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      min-height: auto;
      padding: 28px 0 64px;
    }

    .hero-left {
      max-width: 760px;
    }

    .hero-left h1 {
      max-width: 720px;
      font-size: 4rem;
    }

    .hero-left p {
      max-width: 680px;
    }
  }

  @media (max-width: 760px) {
    .hero {
      gap: 28px;
      padding: 16px 0 56px;
    }

    .hero-left h1 {
      font-size: 3rem;
      line-height: 1.05;
    }

    .hero-left p {
      margin-top: 18px;
      font-size: 1rem;
      line-height: 1.65;
    }
  }

  @media (max-width: 460px) {
    .hero {
      padding-top: 10px;
    }

    .hero-badges {
      margin-bottom: 16px;
    }

    .hero-left h1 {
      font-size: 2.45rem;
    }
  }
</style>
