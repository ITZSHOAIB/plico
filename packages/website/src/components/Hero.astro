---
import EditorPanel from "./EditorPanel.astro";
---

<section class="hero">
  <div class="hero-left">
    <div class="hero-badges"><div class="eyebrow amber">Building in the open</div><span class="pill">pre-release</span></div>
    <h1>Your agent is a <span>folder of files.</span></h1>
    <p>
      Plico is a file-first framework for agent development — still in its
      early stages, built in public. Define identity in <code>agent.md</code>,
      compose skills in Markdown, extend with TypeScript tools.
      No SDK. No lock-in. Just files.
    </p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="https://github.com/anomalyco/plico">★ Star on GitHub</a>
      <a class="btn btn-secondary" href="#how-it-works">Explore the vision</a>
    </div>
  </div>
  <EditorPanel />
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(500px, 1fr);
    gap: 60px;
    align-items: center;
    min-height: calc(100vh - 80px);
    padding: 40px 0 80px;
  }

  .hero-badges {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    padding: 3px 9px;
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 999px;
    background: rgba(255,255,255,0.04);
    color: var(--muted-2);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero-left h1 {
    font-size: clamp(32px, 6.5vw, 88px);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.96;
    overflow-wrap: break-word;
  }

  .hero-left h1 span {
    background: linear-gradient(135deg, var(--green), var(--cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-left p {
    margin-top: 22px;
    color: var(--text-2);
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.7;
    max-width: 560px;
  }
</style>
