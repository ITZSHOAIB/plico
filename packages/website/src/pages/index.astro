---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../components/home/home.css";
import FileHero from "../components/file-hero/FileHero.astro";

const github = "https://github.com/ITZSHOAIB/plico";
const title = "Plico: build AI agents from files";
const description =
  "Plico is a TypeScript kit, in development, that will turn a folder of Markdown and tools into a working AI agent with the harness included.";

const sources = [
  {
    path: "agent.md",
    code: `# Internal Ops Agent

Use the local Markdown instructions
as the source of truth.`,
  },
  {
    path: "skills/triage.md",
    code: `# Triage

Review incoming work items, identify
the smallest safe next step, and
record the outcome.`,
  },
  {
    path: "tools/create-ticket.tool.ts",
    code: `export default {
  name: "create_ticket",
  description: "Create a support ticket.",
  capabilities: ["ticket:write"],
  approval: { required: false },
};`,
  },
];

const stages = [
  { name: "Terminal", note: "Run and test the agent while you write it." },
  { name: "Local Studio", note: "Watch each step, then replay a run to debug it." },
  { name: "Your app", note: "Call it over HTTP or drop in a React chat UI." },
  { name: "Production", note: "Scale to many workers, with the same folder." },
];

const status = [
  {
    title: "Works today",
    items: [
      "Project folder and validation",
      "Scripted runs and evals",
      "Readiness checks",
      "Event log, HTTP API, local Studio",
    ],
  },
  {
    title: "Up next",
    items: [
      "Real model runs with streaming",
      "Approvals that survive a restart",
      "Artifact versions and diffs",
      "Skills and TypeScript tool authoring",
    ],
  },
  {
    title: "Planned",
    items: [
      "Published to npm",
      "MCP tools and memory",
      "AG-UI and a React kit",
      "Postgres and multi-worker production",
    ],
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="wrap">
      <nav class="top">
        <a class="logo" href="/">plico</a>
        <span class="links">
          <a href="/docs">Docs</a>
          <a href={github}>GitHub</a>
        </span>
      </nav>

      <header class="hero">
        <p class="badge"><i></i>In development. Not on npm yet.</p>
        <h1>Build AI agents<br />from files.</h1>
        <p class="lead">Write your agent as a folder of Markdown and TypeScript. Plico will run it, with the whole harness around it already built.</p>
      </header>

      <FileHero />

      <section>
        <h2>You write the agent. Not the plumbing.</h2>
        <p class="sub">A model on its own can only answer. To do real work it needs a harness: a loop, tools, approvals, logs, memory and tests. Most teams build all of that by hand. Plico will do that work for you.</p>
        <div class="compare">
          <div>
            <h3>Without Plico</h3>
            <ul>
              <li>Write the agent loop</li>
              <li>Wire up tools and validation</li>
              <li>Build approval and resume logic</li>
              <li>Add logging, storage and a debug UI</li>
              <li>Then write the agent</li>
            </ul>
          </div>
          <div class="with">
            <h3>With Plico</h3>
            <ul>
              <li>Write the agent</li>
            </ul>
          </div>
        </div>
      </section>

      <section>
        <h2>An agent is just files.</h2>
        <p class="sub">Readable, reviewable and kept in Git like the rest of your code. These come from the example project in the repository.</p>
        <div class="sources">
          {sources.map((s) => (
            <article>
              <header>{s.path}</header>
              <pre><code>{s.code}</code></pre>
            </article>
          ))}
        </div>
      </section>

      <section>
        <h2>One folder, from laptop to production.</h2>
        <p class="sub">The plan is that nothing about the folder changes as the agent grows.</p>
        <ol class="stages">
          {stages.map((s) => <li><b>{s.name}</b><span>{s.note}</span></li>)}
        </ol>
      </section>

      <section>
        <h2>Where it stands</h2>
        <p class="sub">Plico is early. Here is what is real and what is not yet.</p>
        <div class="status">
          {status.map((c) => (
            <div>
              <h3>{c.title}</h3>
              <ul>{c.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </section>

      <footer>
        <a href="/docs">Read the docs</a>
        <a href={github}>Follow the build on GitHub</a>
      </footer>
    </div>
  </body>
</html>
