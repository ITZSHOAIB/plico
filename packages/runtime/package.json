{
  "name": "@plico/runtime",
  "version": "0.0.0",
  "description": "Plico runtime: linear agent runs, durable event log, tools, evals and readiness checks",
  "homepage": "https://plico.sohab.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITZSHOAIB/plico.git",
    "directory": "packages/runtime"
  },
  "keywords": [
    "plico",
    "agent",
    "runtime",
    "evals"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.84",
    "@opentelemetry/api": "1.9.0",
    "@plico/contracts": "workspace:*",
    "@plico/core": "workspace:*",
    "ai": "^7.0.162",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "mime": "4.1.2",
    "picomatch": "4.0.4",
    "tsx": "4.22.4",
    "zod-to-json-schema": "3.25.2"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "2.0.1",
    "@opentelemetry/sdk-trace-base": "2.0.1",
    "@types/picomatch": "^4.0.3",
    "zod": "3.25.76"
  }
}
