{
  "name": "@plico-ai/contracts",
  "version": "0.1.3",
  "description": "Types-only shared contracts (events, runs, artifacts, evals, readiness) for Plico packages",
  "license": "Apache-2.0",
  "homepage": "https://plico.sohab.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITZSHOAIB/plico.git",
    "directory": "packages/contracts"
  },
  "keywords": [
    "plico",
    "agent",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "NOTICE",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
