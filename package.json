{
  "name": "plico",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:docs": "pnpm --filter @plico-ai/docs build",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "smoke:tarballs": "node scripts/smoke-tarballs.mjs",
    "test:watch": "vitest",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish:packages": "node scripts/publish-packages.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "^26.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "8.1.6",
    "vitest": "^4.1.9"
  }
}
